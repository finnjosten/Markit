<Window x:Class="ZoomItToolbar.DrawOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZoomIt Toolbar - Draw"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Grid>
        <Image x:Name="Screenshot" Stretch="Fill" IsHitTestVisible="False"/>

        <InkCanvas x:Name="DrawCanvas" Background="Transparent"/>

        <Grid IsHitTestVisible="False">
            <Border BorderBrush="#FFC107" BorderThickness="8"/>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                    Background="#CC000000" CornerRadius="8" Padding="12,7">
                <TextBlock Text="DRAWING" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Grid>
</Window>
