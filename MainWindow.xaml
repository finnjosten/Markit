<Window x:Class="Markit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Markit"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="ColorDot" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" Stroke="#33FFFFFF" StrokeThickness="1"/>
                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="0" Margin="-3"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Used by the Pen/Highlighter/Eraser tool RadioButtons: exactly one
             stays checked at a time (same GroupName), amber background when active. -->
        <Style x:Key="ToolButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFC107"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="#EE1F1F1F" Padding="10"
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            MouseMove="Border_MouseMove"
            MouseLeftButtonUp="Border_MouseLeftButtonUp">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <DockPanel LastChildFill="False" Height="34">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">

                    <RadioButton x:Name="PenToolButton" GroupName="Tool"
                                 Style="{StaticResource ToolButton}" Checked="PenToolButton_Checked"
                                 ToolTip="Pen">
                        <Viewbox Width="20" Height="20">
                            <StackPanel Orientation="Horizontal" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <RotateTransform Angle="135"/>
                                </StackPanel.RenderTransform>
                                <Border Width="16" Height="6" CornerRadius="3" Background="#F5F5F5"/>
                                <Border x:Name="PenTipIndicator" Width="7" Height="6" CornerRadius="3" Background="#FF4B4B" Margin="-1,0,0,0"/>
                            </StackPanel>
                        </Viewbox>
                    </RadioButton>

                    <RadioButton x:Name="HighlighterToolButton" GroupName="Tool"
                                 Style="{StaticResource ToolButton}" Checked="HighlighterToolButton_Checked"
                                 ToolTip="Highlighter">
                        <Viewbox Width="20" Height="20">
                            <StackPanel Orientation="Horizontal" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <RotateTransform Angle="135"/>
                                </StackPanel.RenderTransform>
                                <Border Width="13" Height="10" CornerRadius="2" Background="#F5F5F5"/>
                                <Border x:Name="HighlighterTipIndicator" Width="8" Height="10" CornerRadius="2" Background="#FFD54F" Margin="-1,0,0,0"/>
                            </StackPanel>
                        </Viewbox>
                    </RadioButton>

                    <RadioButton x:Name="EraserToolButton" GroupName="Tool"
                                 Style="{StaticResource ToolButton}" Checked="EraserToolButton_Checked"
                                 ToolTip="Eraser (X)">
                        <Viewbox Width="20" Height="20">
                            <StackPanel Orientation="Horizontal" RenderTransformOrigin="0.5,0.5">
                                <StackPanel.RenderTransform>
                                    <RotateTransform Angle="-45"/>
                                </StackPanel.RenderTransform>
                                <Border Width="9" Height="12" CornerRadius="2,0,0,2" Background="#F48FB1"/>
                                <Border Width="9" Height="12" CornerRadius="0,2,2,0" Background="#F5F5F5" Margin="-1,0,0,0"/>
                            </StackPanel>
                        </Viewbox>
                    </RadioButton>

                    <Rectangle Width="1" Height="24" Fill="#33FFFFFF" Margin="8,0"/>

                    <Button Style="{StaticResource ActionButton}" Content="&#xE7A7;" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)"/>
                    <Button Style="{StaticResource ActionButton}" Content="&#xE74D;" Click="Clear_Click" ToolTip="Erase all (E)"/>
                    <Button Style="{StaticResource ActionButton}" Content="&#xE74E;" Click="SaveAndCopy_Click" ToolTip="Save &amp; copy screenshot"/>
                </StackPanel>

                <Button Style="{StaticResource ActionButton}" DockPanel.Dock="Right"
                        FontFamily="Segoe UI" FontSize="14"
                        Content="&#x2715;" Click="Exit_Click" ToolTip="Exit drawing mode (Esc)"/>
            </DockPanel>

            <Border x:Name="PalettePanel" Margin="0,10,0,0">
                <StackPanel>
                    <UniformGrid x:Name="ColorGrid" Columns="6" Rows="2">
                        <Button Style="{StaticResource ColorDot}" Background="#FF4B4B" Click="PaletteColor_Click" ToolTip="Red"/>
                        <Button Style="{StaticResource ColorDot}" Background="#4CAF50" Click="PaletteColor_Click" ToolTip="Green"/>
                        <Button Style="{StaticResource ColorDot}" Background="#4A90D9" Click="PaletteColor_Click" ToolTip="Blue"/>
                        <Button Style="{StaticResource ColorDot}" Background="#FF9800" Click="PaletteColor_Click" ToolTip="Orange"/>
                        <Button Style="{StaticResource ColorDot}" Background="#FFD54F" Click="PaletteColor_Click" ToolTip="Yellow"/>
                        <Button Style="{StaticResource ColorDot}" Background="#F48FB1" Click="PaletteColor_Click" ToolTip="Pink"/>
                        <Button Style="{StaticResource ColorDot}" Background="#BF5AF2" Click="PaletteColor_Click" ToolTip="Purple"/>
                        <Button Style="{StaticResource ColorDot}" Background="#5E5CE6" Click="PaletteColor_Click" ToolTip="Indigo"/>
                        <Button Style="{StaticResource ColorDot}" Background="#64D2FF" Click="PaletteColor_Click" ToolTip="Cyan"/>
                        <Button Style="{StaticResource ColorDot}" Background="#AC8E68" Click="PaletteColor_Click" ToolTip="Brown"/>
                        <Button Style="{StaticResource ColorDot}" Background="#FFFFFF" Click="PaletteColor_Click" ToolTip="White"/>
                        <Button Style="{StaticResource ColorDot}" Background="#000000" Click="PaletteColor_Click" ToolTip="Black"/>
                    </UniformGrid>

                    <Slider x:Name="ThicknessSlider" Margin="4,10,4,2" VerticalAlignment="Center"
                            Minimum="2" Maximum="20" Value="4"
                            ValueChanged="ThicknessSlider_ValueChanged"
                            ToolTip="Thickness"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
